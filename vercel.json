{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "standalone-dist",
  "installCommand": "npm ci",
  "functions": {
    "api/session.js": {
      "maxDuration": 30,
      "includeFiles": "build-server/session.cjs"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ]
}
